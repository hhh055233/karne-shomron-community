  if(p.age)t+=`<span class="tag b1">👥 ${esc(p.age)}</span>`;if(p.salary)t+=`<span class="tag b2">💰 ${esc(p.salary)}</span>`;if(p.location)t+=`<span class="tag b3">📍 ${esc(p.location)}</span>`;
