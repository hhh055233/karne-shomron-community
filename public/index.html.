  return `<div class="card${p.promo?' promo':''}" ${cs(i)}>${p.promo?'<span class="tag" style="background:#fde68a;color:#78350f">⭐ מקודם</span>':''}<span class="tag">${CATS[i][1]} ${esc(p.cat)}</span><h3>${esc(p.title)}</h3><p>${esc(p.desc)}</p><div>${t}</div><div class="meta">פורסם על ידי ${esc(p.author)} · ${esc(p.date)}</div>${acts}</div>`}
function list(arr,name){const needle=String(q||'').trim().slice(0,100).toLocaleLowerCase();const f=needle?arr.filter(p=>(String(p.title||'')+' '+String(p.desc||'')+' '+String(p.location||'')).toLocaleLowerCase().includes(needle)):arr;
  if(!f.length)return `<div class="empty"><b>${q?'🔍':'🌱'}</b>${q?'לא נמצאו מודעות שמתאימות לחיפוש.':'עדיין אין מודעות ב'+esc(name)+'. אפשר להיות הראשונים!'}</div>`;
  const A=ld('A3',[]);return f.map((p,k)=>card(p)+(A.length&&k%4===3?spons(A[(k>>2)%A.length]):'')).join('')}
function adsHtml(){const a=ld('A3',[]);if(!a.length)return '';return '<div class="ads">'+a.map(x=>`<a class="ad" href="${/^https?:\/\//.test(x.link)?esc(x.link):'#'}" target="_blank" rel="noopener"><img src="${esc(x.img)}" alt=""><div>${esc(x.txt)}</div></a>`).join('')+'</div>'}
function searchBox(){return `<input class="search" style="margin-bottom:14px;border:1px solid var(--line);background:var(--card);color:var(--ink)" placeholder="🔍 חיפוש מודעות" value="${esc(q)}" oninput="q=this.value;renderList()">`}
function renderList(){const el=$('list');if(!el)return;const source=sharedPosts();const ap=source.filter(p=>p.status==='approved').reverse().sort((a,b)=>(b.promo?1:0)-(a.promo?1:0));el.innerHTML=view==='home'?list(ap,'הלוח'):list(ap.filter(p=>p.cat===CATS[view][0]),CATS[view][0])}
function render(){
  $('greet').textContent=cur?'שלום '+cur:'';const r=role();$('role').hidden=r==='user'||!cur;$('role').textContent=ROLES[r];
  $('adminBtn').hidden=!isMgr();if($('ownerFab'))$('ownerFab').style.display=isMgr()?'block':'none';if($('techFab'))$('techFab').hidden=!canUseTech();$('authBtn').textContent=cur?'התנתק':'כניסה / הרשמה';
  $('chips').innerHTML=`<button class="chip ${view==='home'?'on':''}" onclick="go('home')">🏠 הכול</button>`+CATS.map((c,i)=>`<button class="chip ${view===i?'on':''}" ${cs(i)} onclick="go(${i})">${c[1]} ${c[0]}</button>`).join('');
  let h='';
  if(view==='home'){h=annHtml()+`<div class="hero"><h1>קרני שומרון: הכול במקום אחד</h1><p>דרושים, עסקים, חוגים, אירועים וחדשות של היישוב שלנו.</p><div class="row" style="margin:0 0 12px"><button class="btn" style="background:#fff;color:#1e2440" onclick="shareSite()">↗ שתפו בוואטסאפ</button></div><input class="search" placeholder="🔍 חיפוש מודעות" oninput="q=this.value;renderList()"></div>
    <div class="tiles">${CATS.map((c,i)=>`<button class="tile" ${cs(i)} onclick="go(${i})"><span>${c[1]}</span>${c[0]}</button>`).join('')}<button class="tile" style="--c:#64748b" onclick="openProp()"><span>💡</span>הצע קטגוריה</button></div>${adsHtml()}<h2>מודעות אחרונות</h2><div id="list"></div>${ctaHtml()}`}
  else if(view==='admin'&&isMgr())h=adminHtml();
  else if(typeof view==='number'){h=`<h2 style="color:${CATS[view][2]}">${CATS[view][1]} ${CATS[view][0]}</h2>${searchBox()}${adsHtml()}<div id="list"></div>`}
  else{view='home';return render()}
  h+=`<footer>${hasAdmin()?'<a onclick="openAuth(\'login\')">כניסת מנהלים</a>':'<a onclick="openAuth(\'setup\')">הגדרת מנהל ראשי (פעם ראשונה)</a>'}</footer>`;
  $('main').innerHTML=h;renderList()
