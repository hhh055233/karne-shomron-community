<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>קרני שומרון | הלוח הקהילתי</title>
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4f6fb;--card:#fff;--ink:#1e2440;--mut:#66708f;--line:#e3e7f2;--brand:#4f46e5;--brandInk:#fff;--shadow:0 2px 10px rgba(30,36,64,.07);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#12152a;--card:#1c2039;--ink:#eef0fb;--mut:#a4abc8;--line:#2b3052;--brand:#818cf8;--brandInk:#12152a;--shadow:0 2px 10px rgba(0,0,0,.35)}}
:root[data-theme="dark"]{--bg:#12152a;--card:#1c2039;--ink:#eef0fb;--mut:#a4abc8;--line:#2b3052;--brand:#818cf8;--brandInk:#12152a;--shadow:0 2px 10px rgba(0,0,0,.35)}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*,*:before,*:after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Heebo',Arial,sans-serif;font-size:16px;line-height:1.55;min-height:100%}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer;border:0}
:focus-visible{outline:3px solid var(--brand);outline-offset:2px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--card);box-shadow:var(--shadow)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 16px;max-width:1000px;margin:auto}
.logo{font-weight:800;font-size:22px;color:var(--brand);cursor:pointer}
.me{display:flex;align-items:center;gap:6px;font-size:14px;flex-wrap:wrap;justify-content:flex-end}
.role{background:#fde68a;color:#78350f;border-radius:20px;padding:1px 10px;font-size:12px;font-weight:700}
.btn{background:var(--brand);color:var(--brandInk);border-radius:12px;padding:10px 16px;font-weight:700;min-height:44px}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn.sm{padding:6px 12px;min-height:36px;font-size:14px}
.btn.red{background:#ef4444;color:#fff}.btn.green{background:#16a34a;color:#fff}
.chips{display:flex;gap:8px;overflow-x:auto;padding:4px 16px 12px;max-width:1000px;margin:auto;scrollbar-width:none}
.chip{flex:none;background:color-mix(in srgb,var(--c,var(--brand)) 13%,var(--card));color:var(--ink);border-radius:22px;padding:8px 14px;font-weight:500;min-height:40px;border:2px solid transparent}
.chip.on{background:var(--c,var(--brand));color:#fff;font-weight:700}
main{max-width:1000px;margin:auto;padding:16px 16px 110px}
.hero{background:linear-gradient(135deg,#4f46e5,#ec4899 70%,#f97316);color:#fff;border-radius:22px;padding:24px 20px;margin-bottom:16px}
.hero h1{margin:0 0 4px;font-size:26px;font-weight:800}.hero p{margin:0 0 14px;opacity:.95}
.search{width:100%;padding:13px 16px;border-radius:14px;border:0;background:#fff;color:#1e2440;font-size:16px}
.tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:20px}
@media(min-width:700px){.tiles{grid-template-columns:repeat(4,1fr)}}
.tile{background:var(--c);color:#fff;border-radius:18px;padding:16px 10px;text-align:center;font-weight:700;font-size:17px;box-shadow:var(--shadow)}
.tile span{display:block;font-size:30px;margin-bottom:2px}
h2{font-size:20px;margin:6px 0 12px}
.card{background:var(--card);border-radius:16px;padding:16px;margin-bottom:12px;box-shadow:var(--shadow);border-inline-start:6px solid var(--c,var(--line))}
.card h3{margin:2px 0 4px;font-size:18px}.card p{margin:0 0 8px;white-space:pre-wrap;word-break:break-word}
.tag{display:inline-block;border-radius:20px;padding:2px 10px;font-size:13px;font-weight:500;margin:0 0 6px 6px;background:color-mix(in srgb,var(--c) 15%,var(--card))}
.b1{background:#dbeafe;color:#1e40af}.b2{background:#dcfce7;color:#166534}.b3{background:#ffedd5;color:#9a3412}
.meta{color:var(--mut);font-size:13px}
.empty{text-align:center;padding:36px 16px;color:var(--mut)}.empty b{display:block;font-size:40px}
.ads{display:flex;gap:10px;overflow-x:auto;margin-bottom:16px}
.ad{flex:none;width:180px;background:var(--card);border-radius:14px;overflow:hidden;box-shadow:var(--shadow);text-decoration:none;color:var(--ink)}
.ad img{width:100%;height:100px;object-fit:cover;display:block}.ad div{padding:8px;text-align:center;font-weight:700;font-size:14px}
.fab{position:fixed;inset-inline-start:16px;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:15;background:#f97316;color:#fff;border-radius:30px;padding:0 22px;height:54px;font-weight:800;font-size:17px;box-shadow:0 6px 18px rgba(249,115,22,.45)}
footer{text-align:center;margin-top:24px}footer a{color:var(--mut);font-size:13px;cursor:pointer;text-decoration:underline}
.modal{position:fixed;inset:0;background:rgba(10,12,30,.6);display:none;align-items:center;justify-content:center;z-index:50;padding:12px}
.modal.on{display:flex}
.box{background:var(--card);border-radius:20px;padding:22px;width:440px;max-width:100%;max-height:90vh;overflow:auto}
.box h3{margin:0 0 10px}
.box input,.box textarea,.box select{width:100%;padding:12px;margin:5px 0;border:1px solid var(--line);border-radius:12px;background:var(--bg)}
.box .btn{width:100%;margin-top:8px}
.extra{background:color-mix(in srgb,var(--brand) 8%,var(--card));border:1px dashed var(--brand);border-radius:12px;padding:10px;margin:8px 0;display:none}
.lnk{background:none;color:var(--brand);text-decoration:underline;padding:8px 0;width:100%}
#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(84px + env(safe-area-inset-bottom,0px));background:#1e2440;color:#fff;border-radius:14px;padding:12px 20px;z-index:80;opacity:0;pointer-events:none;transition:opacity .25s;max-width:90%;text-align:center}
#toast.on{opacity:1}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
a.btn{display:inline-flex;align-items:center;text-decoration:none}
.card.promo{box-shadow:0 0 0 2px #f59e0b,var(--shadow)}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}

/* AI revenue assistant */
.ai-fab{position:fixed;right:16px;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:16;background:linear-gradient(135deg,#4f46e5,#7c3aed);color:#fff;border-radius:30px;padding:0 18px;height:54px;font-weight:800;font-size:16px;box-shadow:0 7px 22px rgba(79,70,229,.4)}
.ai-box{width:520px}.ai-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.ai-chat{height:360px;overflow:auto;padding:8px 2px;display:flex;flex-direction:column;gap:8px}.ai-msg{max-width:88%;padding:10px 13px;border-radius:16px;white-space:pre-wrap}.ai-msg.bot{align-self:flex-start;background:color-mix(in srgb,var(--brand) 10%,var(--card))}.ai-msg.user{align-self:flex-end;background:var(--brand);color:var(--brandInk)}.ai-actions{display:flex;gap:7px;flex-wrap:wrap}.ai-actions button{border:1px solid var(--line);background:var(--card);border-radius:18px;padding:7px 11px;cursor:pointer}.ai-lead{border:1px solid var(--line);border-radius:14px;padding:10px;margin-top:5px;background:var(--bg)}
@media(max-width:600px){.ai-box{width:100%}.ai-chat{height:46vh}.ai-fab{right:12px;bottom:calc(82px + env(safe-area-inset-bottom,0px))}}

/* ===== Technical AI Manager ===== */
.tech-fab{position:fixed;right:16px;bottom:calc(84px + env(safe-area-inset-bottom,0px));z-index:16;background:linear-gradient(135deg,#111827,#374151);color:#fff;border-radius:30px;padding:0 17px;height:50px;font-weight:800;font-size:15px;box-shadow:0 7px 22px rgba(17,24,39,.35)}
.tech-box{width:620px}
.tech-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin:10px 0}
.tech-stat{border:1px solid var(--line);background:var(--bg);border-radius:12px;padding:10px}
.tech-stat b{display:block;font-size:20px}
.tech-log{max-height:220px;overflow:auto;border:1px solid var(--line);border-radius:12px;padding:8px;background:#0b1020;color:#dbeafe;font:12px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;direction:ltr;text-align:left}
.tech-ok{color:#86efac}.tech-warn{color:#fde68a}.tech-bad{color:#fca5a5}
.tech-actions{display:flex;gap:7px;flex-wrap:wrap}
@media(max-width:600px){.tech-box{width:100%}.tech-grid{grid-template-columns:1fr}}


/* ===== Dual AI assistants ===== */
.ai-fab.service{right:16px;bottom:calc(18px + env(safe-area-inset-bottom,0px));}
.owner-fab{position:fixed;right:16px;bottom:calc(78px + env(safe-area-inset-bottom,0px));z-index:16;background:linear-gradient(135deg,#0f766e,#0891b2);color:#fff;border-radius:30px;padding:0 18px;height:50px;font-weight:800;font-size:15px;box-shadow:0 7px 22px rgba(8,145,178,.35);display:none}
.dual-box{width:560px}.dual-chat{height:360px;overflow:auto;padding:8px 2px;display:flex;flex-direction:column;gap:8px}
.dual-msg{max-width:90%;padding:10px 13px;border-radius:16px;white-space:pre-wrap}.dual-msg.bot{align-self:flex-start;background:color-mix(in srgb,var(--brand) 10%,var(--card))}.dual-msg.user{align-self:flex-end;background:var(--brand);color:var(--brandInk)}
.dual-msg.note{align-self:stretch;background:#fff7ed;border:1px solid #fed7aa;color:#7c2d12;font-size:13px}
.ai-tabs{display:flex;gap:7px;margin:10px 0}.ai-tabs button{flex:1;border:1px solid var(--line);background:var(--card);border-radius:12px;padding:9px}.ai-tabs button.on{background:var(--brand);color:#fff}
.owner-card{border:1px solid var(--line);border-radius:14px;padding:10px;margin:8px 0;background:var(--bg)}
.owner-card b{display:block;margin-bottom:4px}
@media(max-width:600px){.dual-box{width:100%}.dual-chat{height:46vh}.owner-fab{right:12px;bottom:calc(136px + env(safe-area-inset-bottom,0px));}.ai-fab.service{right:12px;bottom:calc(82px + env(safe-area-inset-bottom,0px))}}

/* ===== Personal AI Developer ===== */
.devai-fab{position:fixed;right:16px;bottom:calc(82px + env(safe-area-inset-bottom,0px));z-index:17;background:linear-gradient(135deg,#111827,#2563eb);color:#fff;border-radius:30px;padding:0 17px;height:50px;font-weight:800;font-size:15px;box-shadow:0 7px 22px rgba(37,99,235,.35);display:none}
.devai-box{width:680px}
.devai-chat{height:320px;overflow:auto;padding:8px 2px;display:flex;flex-direction:column;gap:8px}
.devai-msg{max-width:92%;padding:10px 13px;border-radius:16px;white-space:pre-wrap}
.devai-msg.bot{align-self:flex-start;background:color-mix(in srgb,var(--brand) 10%,var(--card))}
.devai-msg.user{align-self:flex-end;background:var(--brand);color:var(--brandInk)}
.devai-code{background:#0b1020;color:#e5e7eb;border-radius:14px;padding:12px;overflow:auto;direction:ltr;text-align:left;font:12px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace}
.devai-actions{display:flex;gap:7px;flex-wrap:wrap}
.devai-actions button{border:1px solid var(--line);background:var(--card);border-radius:18px;padding:7px 11px;cursor:pointer}
.devai-plan{border:1px dashed var(--brand);border-radius:14px;padding:10px;margin-top:8px;background:color-mix(in srgb,var(--brand) 5%,var(--card))}
@media(max-width:600px){.devai-box{width:100%}.devai-chat{height:46vh}}


/* ===== Board AI ===== */
#board-ai-css{display:none}
.board-ai-fab{position:fixed;left:18px;bottom:88px;z-index:9998;border:0;border-radius:999px;padding:13px 17px;background:#111827;color:#fff;font-weight:800;box-shadow:0 10px 30px #0003;cursor:pointer}
.board-ai-modal{position:fixed;inset:0;background:#0007;z-index:9999;display:none;align-items:center;justify-content:center;padding:14px}
.board-ai-modal.show{display:flex}.board-ai-box{width:min(760px,100%);max-height:90vh;overflow:auto;background:#fff;border-radius:22px;padding:18px;direction:rtl}
.board-ai-head{display:flex;align-items:center;justify-content:space-between}.board-ai-chat{min-height:260px;max-height:48vh;overflow:auto;border:1px solid #e5e7eb;border-radius:16px;padding:12px;background:#f8fafc}
.board-ai-msg{padding:10px 12px;border-radius:14px;margin:8px 0;white-space:pre-wrap}.board-ai-msg.bot{background:#fff;border:1px solid #e5e7eb}.board-ai-msg.user{background:#111827;color:#fff;margin-right:15%}
.board-ai-input{display:flex;gap:8px;margin-top:10px}.board-ai-input textarea{flex:1;min-height:60px;resize:vertical;border:1px solid #cbd5e1;border-radius:12px;padding:10px}.board-ai-plan{margin-top:10px;border:1px dashed #94a3b8;border-radius:14px;padding:10px;background:#f8fafc}
</style></head>
<body>
<header>
  <div class="bar">
    <div class="logo" onclick="go('home')">📋 קרני שומרון</div>
    <div class="me"><span id="greet"></span><span class="role" id="role" hidden></span>
      <button class="btn ghost sm" id="adminBtn" onclick="go('admin')" hidden>👑 ניהול</button>
      <button class="btn ghost sm" id="themeBtn" onclick="theme()" aria-label="מצב תצוגה">🌓</button>
      <button class="btn sm" id="authBtn" onclick="authBtn()">כניסה</button></div>
  </div>
  <nav class="chips" id="chips"></nav>
</header>
<main id="main"></main>
<button class="fab" onclick="openPost()">➕ פרסם מודעה</button>
<div id="toast" role="status"></div>
<button class="ai-fab service" onclick="openServiceAI()">🤖 עוזר שירות</button>
<button class="owner-fab" id="ownerFab" onclick="openOwnerAI()">🧠 העוזר שלי</button>

<div class="modal" id="m-service"><div class="box dual-box">
  <div class="ai-head"><div><h3 style="margin-bottom:2px">🤖 עוזר השירות</h3><small style="color:var(--mut)">עוזר למשתמשים למצוא מידע, שירותים ועסקים בלוח</small></div><button class="btn ghost sm" onclick="shut('service')">✕</button></div>
  <div id="serviceChat" class="dual-chat"></div>
  <div class="ai-actions" id="serviceQuick"></div>
  <div class="row"><input id="serviceInput" placeholder="למשל: אני מחפש אינסטלטור" onkeydown="if(event.key==='Enter')serviceSend()"><button class="btn sm" onclick="serviceSend()">שלח</button></div>
</div></div>

<div class="modal" id="m-owner"><div class="box dual-box">
  <div class="ai-head"><div><h3 style="margin-bottom:2px">🧠 העוזר האישי שלך</h3><small style="color:var(--mut)">עוזר לך לנהל פניות, עמודים, תמחור והסברים על תשלום</small></div><button class="btn ghost sm" onclick="shut('owner')">✕</button></div>
  <div id="ownerChat" class="dual-chat"></div>
  <div class="ai-actions" id="ownerQuick"></div>
  <div class="row"><input id="ownerInput" placeholder="כתוב לי מה אתה רוצה שאעשה" onkeydown="if(event.key==='Enter')ownerSend()"><button class="btn sm" onclick="ownerSend()">שלח</button></div>
  <div class="owner-card"><b>🔐 מצב אבטחה</b>בפרסום אמיתי יש להשתמש בשרת מאובטח. פרטי תשלום לא נשמרים בצד הלקוח ולא מזינים כאן סיסמאות, קודי SMS או פרטי התחברות לבנק.</div>
  <div class="owner-card"><b>💳 תשלומים</b>העוזר יכול להסביר ללקוח איך לבצע העברה בנקאית לפי פרטי תשלום ציבוריים שהוגדרו בשרת. הוא לא מבקש סיסמת בנק, קוד אימות או גישה לחשבון, ולא מבצע העברה בעצמו.</div>
  <div class="owner-card"><b>🌐 עמוד עסקי</b>העוזר יכול לאסוף דרישות לעמוד, להכין מפרט והצעת מחיר, ולשמור פנייה להמשך טיפול. תשלום חודשי בפועל צריך להתבצע דרך מערכת תשלומים מאובטחת ולא דרך הצ'אט.</div>
</div></div>



<button class="tech-fab" id="techFab" onclick="openTechManager()" hidden>🛠️ מנהל טכני AI</button>

<div class="modal" id="m-tech"><div class="box tech-box">
  <div class="ai-head">
    <div>
      <h3 style="margin-bottom:2px">🛠️ מנהל טכני AI</h3>
      <small style="color:var(--mut)">אבחון, ניטור ותחזוקה — עם הרשאות מוגבלות</small>
    </div>
    <button class="btn ghost sm" onclick="shut('tech')">✕</button>
  </div>
  <div class="tech-grid">
    <div class="tech-stat"><span>שרת</span><b id="techServer">בודק...</b></div>
    <div class="tech-stat"><span>סשן</span><b id="techSession">בודק...</b></div>
    <div class="tech-stat"><span>מודעות</span><b id="techPosts">—</b></div>
    <div class="tech-stat"><span>אחסון מקומי</span><b id="techStorage">בודק...</b></div>
  </div>
  <div class="tech-actions">
    <button class="btn sm" onclick="techDiagnose()">🔍 אבחון מלא</button>
    <button class="btn ghost sm" onclick="techSync()">🔄 סנכרון</button>
    <button class="btn ghost sm" onclick="techHealth()">❤️ בדיקת שרת</button>
  </div>
  <h4>יומן טכני</h4>
  <div id="techLog" class="tech-log">ממתין לבדיקה...</div>
  <div class="row">
    <input id="techInput" placeholder="שאל את המנהל הטכני, למשל: בדוק למה הסנכרון נכשל" maxlength="500">
    <button class="btn sm" onclick="techAsk()">שאל</button>
  </div>
  <small id="techSafetyNote" style="display:block;margin-top:8px;color:var(--mut)">
    במצב ללא שרת, המנהל הטכני יכול לבצע אבחון מקומי בלבד. פעולות מסוכנות כמו מחיקה, שינוי הרשאות או שינוי קוד אינן מבוצעות אוטומטית.
  </small>
</div></div>

<div class="modal" id="m-auth"><div class="box">
  <h3 id="authT"></h3>
  <input id="aU" placeholder="שם משתמש" autocomplete="username">
  <input id="aP" type="password" placeholder="סיסמה (6 תווים לפחות)" autocomplete="current-password">
  <button class="btn" id="authGo" onclick="authGo()"></button>
  <button class="lnk" id="authSw" onclick="openAuth(mode==='login'?'reg':'login')"></button>
  <button class="btn ghost" onclick="shut('auth')">סגור</button>
</div></div>

<div class="modal" id="m-post"><div class="box">
  <h3>פרסום מודעה חדשה</h3>
  <select id="pC" onchange="extra()"></select>
  <input id="pT" placeholder="כותרת המודעה">
  <textarea id="pD" placeholder="תיאור" rows="3"></textarea>
  <input id="pP" placeholder="טלפון ליצירת קשר (לא חובה)" inputmode="tel" dir="ltr">
  <div class="extra" id="extra">
    <b id="exT"></b>
    <input id="pA"><input id="pS"><input id="pL">
  </div>
  <button class="btn" onclick="submitPost()">שלח לאישור</button>
  <button class="btn ghost" onclick="shut('post')">ביטול</button>
</div></div>

<div class="modal" id="m-ad"><div class="box">
  <h3>הוספת פרסומת</h3>
  <input id="adF" type="file" accept="image/*">
  <input id="adL" placeholder="קישור (https://...)" dir="ltr">
  <input id="adX" placeholder="טקסט קצר">
  <button class="btn" onclick="saveAd()">שמור</button>
  <button class="btn ghost" onclick="shut('ad')">ביטול</button>
</div></div>

<div class="modal" id="m-prop"><div class="box">
  <h3>💡 הצעת קטגוריה</h3>
  <textarea id="prT" rows="3" placeholder="איזו קטגוריה חסרה לך?"></textarea>
  <button class="btn" onclick="sendProp()">שלח</button>
  <button class="btn ghost" onclick="shut('prop')">ביטול</button>
</div></div>

<script>
const $=id=>document.getElementById(id);
const BASE=[['דרושים','💼','#3b82f6'],['חנויות','🏪','#8b5cf6'],['חוגים','🎨','#f97316'],['אירועים','🎉','#ec4899'],['יד2','📦','#0d9488'],['חדשות','📰','#ef4444'],['למסירה','🎁','#16a34a'],['נדל"ן','🏠','#0ea5e9'],['שירותים','🔧','#ca8a04'],['התנדבות','🤝','#0891b2'],['קהילה','💬','#7c3aed']];
const ROLES={user:'',manager:'מנהל',super_manager:'מנהל בכיר',super_admin:'מנהל ראשי'};
