function closeAll(){document.querySelectorAll('.modal').forEach(x=>x.classList.remove('show'))}
function open(id){const m=$(id);if(m)m.classList.add('show')}
function shut(id){const m=$(id);if(m)m.classList.remove('show')}
document.addEventListener('click',e=>{if(e.target.classList.contains('modal'))e.target.classList.remove('show')});
function toast(t){const x=$('toast');if(!x)return;x.textContent=t;x.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>x.classList.remove('show'),2800)}
function go(v){view=v;q='';render();window.scrollTo({top:0,behavior:'smooth'})}
function openAuth(mode){
  authMode=mode;
  $('authTitle').textContent=mode==='setup'?'הגדרת מנהל ראשי':'כניסה / הרשמה';
  $('authName').value='';$('authPass').value='';
  $('authErr').textContent='';
  open('auth');
}
async function authSubmit(){
  const n=$('authName').value.trim().slice(0,40),p=$('authPass').value;
  if(!n||!p)return $('authErr').textContent='יש למלא שם וסיסמה';
  if(SERVER_CONFIG.enabled){
    try{
      const endpoint=authMode==='setup'?'/api/auth/setup':'/api/auth/login';
      const d=await api(endpoint,{method:'POST',body:JSON.stringify({username:n,password:p})});
      serverSession=d.session||null;cur=d.user?.username||n;
      sv('LUACH_SESSION',serverSession);sv('CUR3',cur);
      shut('auth');await syncSession();await syncPosts();await syncConfig();render();toast(authMode==='setup'?'המנהל הראשי נוצר':'התחברת בהצלחה');return;
    }catch(e){$('authErr').textContent=e.status===401?'פרטי התחברות שגויים':e.status===409?'כבר קיים מנהל ראשי':'שגיאת שרת: '+e.message;return}
  }
  const U=users();
  if(authMode==='setup'){
    if(Object.keys(U).some(k=>U[k].role==='super_admin'))return $('authErr').textContent='כבר הוגדר מנהל ראשי';
    U[n]={role:'super_admin',pass:p};sv('U3',U);cur=n;sv('CUR3',cur);shut('auth');render();toast('המנהל הראשי הוגדר');return;
  }
  if(U[n]&&U[n].pass===p){cur=n;sv('CUR3',cur);shut('auth');render();toast('התחברת בהצלחה')}
  else if(U[n])$('authErr').textContent='סיסמה שגויה';
  else{U[n]={role:'user',pass:p};sv('U3',U);cur=n;sv('CUR3',cur);shut('auth');render();toast('נרשמת והתחברת')}
}
function logout(){
  cur=null;serverSession=null;sv('CUR3',null);sv('LUACH_SESSION',null);render();toast('התנתקת');
}
function openPost(){
  if(!cur){toast('כדי לפרסם מודעה צריך להתחבר');return openAuth('login')}
  $('pT').value='';$('pD').value='';$('pA').value='';$('pS').value='';$('pL').value='';$('pP').value='';
  $('pCat').innerHTML=CATS.map((c,i)=>`<option value="${esc(c[0])}">${c[1]} ${esc(c[0])}</option>`).join('');
  open('post');
}
function savePost(){
  const cat=$('pCat').value,title=$('pT').value.trim(),desc=$('pD').value.trim();
  if(!title||!desc)return toast('צריך כותרת ותיאור');
  if(title.length>100||desc.length>1000)return toast('הטקסט ארוך מדי');
  if((cat==='דרושים'||cat==='חוגים')&&(!g('pA')||!g('pS')||!g('pL')))return toast('בדרושים ובחוגים צריך למלא גילאים, שכר או עלות, ומיקום');
  const P=posts();P.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),cat,title,desc,age:g('pA'),salary:g('pS'),location:g('pL'),phone:g('pP').replace(/[^\d+]/g,''),author:cur,status:'pending',date:new Date().toLocaleDateString('he-IL')});
  const item=P[P.length-1];sv('P3',P);if(SERVER_CONFIG.enabled)api('/api/posts',{method:'POST',body:JSON.stringify(item)}).then(syncPosts).catch(e=>console.warn(e));shut('post');render();toast('המודעה נשלחה לאישור ותופיע אחרי שמנהל יאשר אותה')
}
function closeOnEsc(e){if(e.key==='Escape')closeAll()}
document.addEventListener('keydown',closeOnEsc);
window.addEventListener('load',async()=>{
  try{
    serverSession=ld('LUACH_SESSION',null);
    cur=ld('CUR3',null);
    render();
    await syncSession();
    await syncConfig();
    await syncPosts();
    render();
  }catch(e){console.warn('init error',e);render()}
});
</script>
<button id="boardAiFab" class="board-ai-fab" hidden onclick="openBoardAI()">🧠 בורד — מנהל האתר</button>
<div id="boardAiModal" class="board-ai-modal" aria-hidden="true"><div class="board-ai-box">
<div class="board-ai-head"><div><h2 style="margin:0">🧠 בורד</h2><div style="font-size:12px;color:#64748b">AI ניהול ופיתוח — מנהל ראשי בלבד</div></div><button onclick="closeBoardAI()">✕</button></div>
<div id="boardAiStatus"></div><div id="boardAiChat" class="board-ai-chat"></div><div id="boardAiPlan" class="board-ai-plan" hidden></div>
<div class="board-ai-input"><textarea id="boardAiInput" maxlength="2000" placeholder="לדוגמה: בורד, תשדרג את מערכת הטרמפים"></textarea><button onclick="boardAiSend()">שלח</button></div>
<div style="font-size:12px;color:#b91c1c">בורד אינו מקבל סיסמאות, קודי SMS או פרטי בנק. פעולות מסוכנות דורשות אישור.</div>
</div></div><script id="board-ai-js">
const BOARD_AI_CONFIG={endpoint:window.BOARD_AI_API_URL||'/api/ai/board',maxMessage:2000};
let boardAiBusy=false,boardAiActivated=false,boardAiPendingTask=null;
function canUseBoardAI(){return typeof role==='function'&&role()==='super_admin'}
function boardAiLog(t,type='bot'){const b=document.getElementById('boardAiChat');if(!b)return;const d=document.createElement('div');d.className='board-ai-msg '+(type==='user'?'user':'bot');d.textContent=String(t||'');b.appendChild(d);b.scrollTop=b.scrollHeight}
function openBoardAI(){
  if(!canUseBoardAI()){alert('בורד זמין רק למנהל הראשי.');return}
  const m=document.getElementById('boardAiModal');m.classList.add('show');m.setAttribute('aria-hidden','false');
  if(!document.getElementById('boardAiChat').children.length){
    boardAiLog('🧠 בורד מוכן.');
    boardAiLog('שלב 1: כתוב בדיוק "בורד בורדי".\nשלב 2: כתוב מה אתה רוצה שאעשה.\nשלב 3: אני אציג תוכנית ושינויים מוצעים. רק אם תכתוב בדיוק "ברהב" בורד יבצע את השינוי המאושר ב-GitHub.');
  }
}
function closeBoardAI(){const m=document.getElementById('boardAiModal');m.classList.remove('show');m.setAttribute('aria-hidden','true')}
function boardAiPlanShow(p){const e=document.getElementById('boardAiPlan');if(!p){e.hidden=true;e.textContent='';return}let t='תוכנית עבודה:\n'+(p.steps||[]).map((x,i)=>(i+1)+'. '+x).join('\n');if(p.file)t+='\n\nקובץ: '+p.file;if(p.summary)t+='\nסיכום: '+p.summary;if(Array.isArray(p.changes)&&p.changes.length)t+='\n\nשינויים שהוצעו: '+p.changes.length+' קטעים';e.hidden=false;e.textContent=t}
async function boardAiSend(){
  if(boardAiBusy||!canUseBoardAI())return;
  const i=document.getElementById('boardAiInput'),msg=i.value.trim().slice(0,BOARD_AI_CONFIG.maxMessage);if(!msg)return;
  i.value='';boardAiLog(msg,'user');boardAiBusy=true;document.getElementById('boardAiStatus').textContent='בורד עובד…';
  try{
    if(!boardAiActivated){
      if(msg!=='בורד בורדי'){boardAiLog('כדי להתחיל כתוב בדיוק: בורד בורדי');return}
      const r=await api(BOARD_AI_CONFIG.endpoint,{method:'POST',body:JSON.stringify({message:msg,requestedBy:cur})});
      boardAiActivated=true;boardAiPendingTask=null;boardAiPlanShow(null);boardAiLog(r.reply||'בורד הופעל.');return;
    }
    if(msg==='ברהב'){
      if(!boardAiPendingTask){boardAiLog('אין כרגע משימה ממתינה לאישור. קודם כתוב את המשימה.');return}
      const r=await api(BOARD_AI_CONFIG.endpoint,{method:'POST',body:JSON.stringify({message:'ברהב',approvalPhrase:'ברהב',taskId:boardAiPendingTask,requestedBy:cur})});
      boardAiLog(r.reply||'בוצע.');
      if(r.action==='add_category'&&r.category){const X=ld('C3',[]);if(!X.some(c=>c[0]===r.category[0])){X.push(r.category);sv('C3',X)}CATS=BASE.concat(X);render();}
      if(r.action==='set_announcement'&&typeof r.announcement==='string'){const S=ld('S3',{});S.ann=r.announcement;sv('S3',S);render();}
      if(r.action==='github_code_change'){boardAiLog((r.commitUrl?'🔗 '+r.commitUrl+'\n':'')+'השינוי נשמר ב-GitHub.','bot');}
      boardAiPendingTask=null;boardAiPlanShow(null);return;
    }
    boardAiPlanShow(null);
    const r=await api(BOARD_AI_CONFIG.endpoint,{method:'POST',body:JSON.stringify({message:msg,activated:true,requestedBy:cur,capabilities:['inspect_site','diagnose','read_code','search_code','preview_change','add_category','update_settings','stats','list_categories']})});
    if(r.plan)boardAiPlanShow(r.plan);
    boardAiPendingTask=r.taskId||null;
    boardAiLog(r.reply||'התוכנית מוכנה.');
    if(r.needsApproval)boardAiLog('🔐 לא בוצע שינוי. בדוק את התוכנית. אם אתה מאשר בדיוק את השינוי המוצג, כתוב: ברהב');
  }catch(e){boardAiLog('בורד עצר את הפעולה: '+String(e.message||e))}
  finally{boardAiBusy=false;document.getElementById('boardAiStatus').textContent=''}
}
const _boardRender=render;render=function(){_boardRender();const b=document.getElementById('boardAiFab');if(b)b.hidden=!canUseBoardAI()};
</script></body>
