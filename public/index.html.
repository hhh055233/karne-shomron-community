function localOwnerAI(msg){
  const m=normalize(msg);
  if(/(מצב|סטטוס|בדיקה)/.test(m))return {text:`מצב האתר כרגע:\n👥 משתמש מחובר: ${cur||'לא מחובר'}\n📋 מודעות: ${sharedPosts().length}\n🖥️ שרת: ${SERVER_CONFIG.enabled?'מופעל':'כבוי'}`,quick:['איך להוסיף קטגוריה?','איך לפרסם עסק?']};
  if(/(קטגוריה)/.test(m))return {text:'מנהל בכיר או מנהל ראשי יכולים לאשר הצעות קטגוריה מתוך פאנל הניהול.',quick:['בדיקת מצב האתר','איך לפרסם עסק?']};
  if(/(עסק|פרסם|פרסום)/.test(m))return {text:'אפשר להציע לעסקים פרסום דרך הלוח, כולל מודעה מקודמת, באנר או פרסום ממומן.',quick:['בדיקת מצב האתר','איך להוסיף קטגוריה?']};
  return {text:'אני יכול לעזור בניהול הלוח, קטגוריות, פרסום ופעולות מנהל.',quick:['בדיקת מצב האתר','איך להוסיף קטגוריה?','איך לפרסם עסק?']};
}
